{
  "name": "mobile-mining-app",
  "version": "1.0.0",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "start": "expo start",
    "prebuild": "expo prebuild",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "web": "expo start --web",
    "db:pull:jmdict": "drizzle-kit pull --config=drizzle.jmdict.config.ts",
    "db:generate:files": "drizzle-kit generate --config=drizzle.app.config.ts",
    "db:sync": "npm run db:pull:jmdict && npm run db:generate:files"
  },
  "dependencies": {
    "@expo/ui": "~55.0.17",
    "@expo/vector-icons": "^15.0.3",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@kuzulabz/expo-kagome": "^0.2.1",
    "babel-plugin-inline-import": "^3.0.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "expo": "~55.0.27",
    "expo-asset": "~55.0.17",
    "expo-constants": "~55.0.16",
    "expo-dev-client": "~55.0.36",
    "expo-document-picker": "~55.0.14",
    "expo-file-system": "~55.0.23",
    "expo-font": "~55.0.8",
    "expo-image-picker": "~55.0.21",
    "expo-linking": "~55.0.16",
    "expo-router": "~55.0.16",
    "expo-sqlite": "~55.0.17",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-video": "~55.0.18",
    "genanki-ts": "0.1.0",
    "jszip": "^3.10.1",
    "nativewind": "latest",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4",
    "srt-parser-2": "^1.2.3",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "^55.0.18",
    "better-sqlite3": "^12.10.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.25.1",
    "eslint-config-expo": "~55.0.1",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.9.2"
  },
  "main": "expo-router/entry",
  "private": true,
  "workspaces": [
    "packages/*"
  ]
}
